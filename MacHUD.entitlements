<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required under the hardened runtime to send Apple Events (desktop switching,
         browser windows, nudging freshly launched apps). Without it macOS denies
         silently and never shows the Automation prompt. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
